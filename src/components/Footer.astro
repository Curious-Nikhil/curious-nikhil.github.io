---
import type { HTMLAttributes } from "astro/types";
import Socials from "./Socials.astro";
import footerBg from "@/assets/images/footer-bg.svg?url";

const currentYear = new Date().getFullYear();

type Props = {
  noMarginTop?: boolean;
} & HTMLAttributes<"footer">;

const { noMarginTop = false, class: className, ...attrs } = Astro.props;
---

<footer
  class:list={["relative app-layout", { "mt-auto": !noMarginTop }, className]}
  {...attrs}
>
  <div class="absolute inset-0 -z-10 overflow-hidden opacity-10">
    <img src={footerBg} alt="" class="h-full w-full object-cover" />
  </div>

  <div
    class:list={[
      "py-6 sm:py-4",
      "border-t border-border",
      "flex flex-col items-center justify-between sm:flex-row-reverse",
    ]}
  >
    <Socials />
    <div class="my-2 flex flex-col items-center whitespace-nowrap sm:flex-row">
      <span>Mischief Managed &#169; {currentYear}</span>
      <span class="hidden sm:inline">&nbsp;|&nbsp;</span>
      <span>All rights reserved.</span>
      <span class="hidden sm:inline">&nbsp;|&nbsp;</span>
      <img
        src="/india-fav-16x16.png"
        alt="India flag"
        class="mt-1 h-4 w-4 sm:mt-0"
      />
    </div>
  </div>
</footer>
