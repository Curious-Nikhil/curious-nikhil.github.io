---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { SITE } from "@/config";

const { frontmatter } = Astro.props;
const title = frontmatter?.title || "Portfolio";
---

<Layout title={`${title} | ${SITE.title}`}>
  <Header activeNav="portfolio" />
  <main class="mx-auto w-full max-w-3xl px-4 py-12">
    <h1 class="mb-8 text-center text-3xl font-bold sm:text-4xl">{title}</h1>
    <slot />
  </main>
  <Footer />
</Layout>
